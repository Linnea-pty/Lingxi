# compose.yaml 的环境变量模板
# 用法：复制为 .env（同目录）后填入真实值——.env 已在 .gitignore 中，不会进版本库
# 缺失必填项时 docker compose 会直接报错退出（见 compose.yaml 里的 ${VAR:?...}）

# ---- 必填：数据库 ----
# 本地开发与 application.properties 的默认值保持一致（root/123456），否则本机跑的应用连不上容器
MYSQL_ROOT_PASSWORD=123456

# ---- 必填：缓存 ----
# 应用侧通过 spring.data.redis.password=${REDIS_PASSWORD} 读取
REDIS_PASSWORD=123456

# ---- 必填：JWT 签名密钥 ----
# Base64 编码、解码后 ≥32 字节；强度不足应用启动即失败（Fail-Fast）
# 生成方式见 README「必填环境变量」，生成后把内容贴到等号后面（不要带引号）
JWT_SECRET=

# ---- 可选：端口（默认值与 README 一致）----
MYSQL_PORT=3306
REDIS_PORT=6379
APP_PORT=18080

# ---- 可选：接口文档开关（生产建议 false）----
SPRINGDOC_ENABLED=true

# ---- 可选：构建基础镜像（内网/离线环境改自建仓库地址）----
BUILD_IMAGE=eclipse-temurin:25-jdk
RUNTIME_IMAGE=eclipse-temurin:25-jre
